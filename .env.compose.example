# Local production-topology example. This file contains no production secrets.
COMPOSE_PROJECT_NAME=closetsearch
NODE_ENV=development
PERSISTENCE_DRIVER=postgres

POSTGRES_DB=closetsearch
POSTGRES_USER=closetsearch
POSTGRES_PASSWORD=local-compose-password-change-me
POSTGRES_PORT=5432
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=12000
POSTGRES_TRANSACTION_RETRY_LIMIT=3

API_PORT=4000
WEB_PORT=8080
VITE_API_BASE_URL=http://localhost:4000
CLOSETSEARCH_API_IMAGE=closetsearch-api:local
CLOSETSEARCH_WORKER_IMAGE=closetsearch-worker:local
CLOSETSEARCH_WEB_IMAGE=closetsearch-web:local

AUTH_ALLOWED_ORIGINS=http://localhost:8080
AUTH_SESSION_COOKIE_NAME=closetsearch_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_SESSION_PEPPER=local-compose-session-pepper-change-before-production
ENGAGEMENT_SESSION_PEPPER=local-compose-engagement-pepper-change-before-production
OPERATIONS_BEARER_TOKEN=local-compose-operations-token-change-before-production

# Outbound alerts are globally disabled until a transport, verified identities,
# and explicit channel/watchlist consent are configured.
ALERT_DELIVERY_ENABLED=false
ALERT_DELIVERY_CLAIM_TIMEOUT_MS=300000
ALERT_PUBLIC_BASE_URL=http://localhost:8080
ACCOUNT_ACTION_BASE_URL=http://localhost:8080
NOTIFICATION_DESTINATION_PEPPER=local-compose-notification-destination-pepper-change-before-production
EMAIL_TRANSPORT=disabled
EMAIL_FROM_ADDRESS=
EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=
SMS_TRANSPORT=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional compatibility value; when set it must equal TWILIO_AUTH_TOKEN.
TWILIO_WEBHOOK_SECRET=

# The fixture model is not promotion evidence. Keep disabled unless a reviewed
# immutable artifact is mounted into the API container.
CLOSETSEARCH_RECOMMENDATION_MODE=disabled
CLOSETSEARCH_RECOMMENDATION_ARTIFACT_PATH=
CLOSETSEARCH_RECOMMENDATION_PROMOTION_APPROVED=false
CLOSETSEARCH_RECOMMENDATION_TIMEOUT_MS=25
CLOSETSEARCH_RECOMMENDATION_MAX_ARTIFACT_AGE_DAYS=45

# Mock inventory is deliberately disabled in this topology.
PROVIDER_RUNTIME_MODE=real
PROVIDER_ALLOW_MOCK_FALLBACK=false
PROVIDER_MOCK_ENABLED=false
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_ACTIVE_PROVIDERS=5
LIVE_PROVIDER_SMOKE_TESTS=false

# Enable only providers for which the required credentials/authorization exist.
EBAY_PROVIDER_ENABLED=false
EBAY_AUTHORIZATION_REFERENCE=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_LOCALE=en-US
EBAY_AFFILIATE_CAMPAIGN_ID=
EBAY_AFFILIATE_REFERENCE_ID=

GRAILED_PROVIDER_ENABLED=false
GRAILED_SCRAPING_ALLOWED=false
GRAILED_AUTHORIZATION_REFERENCE=
GRAILED_USER_AGENT=ClosetSearchBot/0.1 contact:<project-contact-email>

DEPOP_PROVIDER_ENABLED=false
DEPOP_SCRAPING_ALLOWED=false
DEPOP_AUTHORIZATION_REFERENCE=
DEPOP_BASE_URL=https://webapi.depop.com
DEPOP_USER_AGENT=ClosetSearchBot/1.0 contact:<project-contact-email>

YAHOO_AUCTIONS_JP_PROVIDER_ENABLED=false
YAHOO_AUCTIONS_JP_SCRAPING_ALLOWED=false
YAHOO_AUCTIONS_JP_AUTHORIZATION_REFERENCE=
YAHOO_AUCTIONS_JP_BASE_URL=https://auctions.yahoo.co.jp
YAHOO_AUCTIONS_JP_USER_AGENT=ClosetSearchBot/1.0 contact:<project-contact-email>

MERCARI_JP_PROVIDER_ENABLED=false
MERCARI_JP_SCRAPING_ALLOWED=false
MERCARI_JP_AUTHORIZATION_REFERENCE=
MERCARI_JP_BASE_URL=https://api.mercari.jp
MERCARI_JP_USER_AGENT=ClosetSearchBot/1.0 contact:<project-contact-email>

WORKER_CONCURRENCY=4
WORKER_PROVIDER_INGESTION_ENABLED=true
WORKER_DEFAULT_INGESTION_QUERY=designer clothing
WORKER_ACTIVE_INGESTION_INTERVAL_SECONDS=900
WORKER_SOLD_INGESTION_INTERVAL_SECONDS=3600
WORKER_INGESTION_PAGE_SIZE=50
WORKER_INGESTION_SEARCHES_JSON=
WORKER_LEASE_DURATION_MS=60000
WORKER_POLL_INTERVAL_MS=2000

BACKUP_RETENTION_DAYS=14
BACKUP_REQUIRE_ENCRYPTION=false
BACKUP_AGE_RECIPIENT=
