# Copy to .env when local configuration is needed.

# App
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Provider runtime
# mock: only the mock provider is active
# hybrid: mock stays active and approved real providers can join when configured
# real: approved real providers are preferred; mock can still be used as a fallback when allowed
PROVIDER_RUNTIME_MODE=mock
PROVIDER_ALLOW_MOCK_FALLBACK=true
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_ACTIVE_PROVIDERS=2

# Provider toggles
PROVIDER_MOCK_ENABLED=true

# Grailed provider
# Live scraping is disabled by default and must stay off unless the project retains
# explicit written permission from Grailed for ClosetSearch.
# Do not bypass login walls, CAPTCHA, anti-bot systems, robots.txt restrictions,
# private endpoints, or rate limits.
GRAILED_PROVIDER_ENABLED=false
GRAILED_SCRAPING_ALLOWED=false
GRAILED_BASE_URL=https://www.grailed.com
GRAILED_REQUEST_TIMEOUT_MS=5000
GRAILED_MIN_REQUEST_INTERVAL_MS=3000
GRAILED_MAX_RESULTS_PER_SEARCH=24
GRAILED_USER_AGENT="ClosetSearchBot/0.1 contact:<project-contact-email>"
