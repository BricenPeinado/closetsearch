# ClosetSearch local development example. Never commit populated secret files.

# API process
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
SHUTDOWN_TIMEOUT_MS=10000
PERSISTENCE_DRIVER=sqlite

# SQLite is an explicitly local/test compatibility store. Production startup
# requires PERSISTENCE_DRIVER=postgres and ignores this path.
CLOSETSEARCH_DB_PATH=./apps/api/.data/closetsearch.sqlite

# PostgreSQL data plane and worker
DATABASE_URL=postgresql://closetsearch:change-me@127.0.0.1:5432/closetsearch
POSTGRES_APPLICATION_NAME=closetsearch-api
POSTGRES_SSL_MODE=disable
POSTGRES_ALLOW_INSECURE=true
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=12000
POSTGRES_TRANSACTION_RETRY_LIMIT=3

# Auth/session
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_COOKIE_NAME=closetsearch_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_SESSION_PEPPER=
AUTH_TOKEN_PEPPER=
ENGAGEMENT_SESSION_PEPPER=
REQUEST_STORE_IP_HINT_PEPPER=
ACCOUNT_ACTION_BASE_URL=http://localhost:5173
ENTITLEMENT_ADMIN_DEVELOPMENT_ENABLED=false
OPERATIONS_BEARER_TOKEN=

# Outbound alert transports are fail-closed. Never use capture mode in production.
ALERT_DELIVERY_ENABLED=false
ALERT_DELIVERY_CLAIM_TIMEOUT_MS=300000
ALERT_PUBLIC_BASE_URL=http://localhost:5173
NOTIFICATION_DESTINATION_PEPPER=
EMAIL_TRANSPORT=disabled
EMAIL_FROM_ADDRESS=
EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=
SMS_TRANSPORT=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio verifies X-Twilio-Signature with its Auth Token. If this compatibility
# variable is set, startup requires it to exactly equal TWILIO_AUTH_TOKEN.
TWILIO_WEBHOOK_SECRET=

# Recommendation runtime. Disabled is the fail-closed default. Shadow mode
# requires an immutable artifact produced by packages/ml but does not change
# returned rankings. Active mode additionally requires a promoted artifact and
# the explicit promotion approval gate.
CLOSETSEARCH_RECOMMENDATION_MODE=disabled
CLOSETSEARCH_RECOMMENDATION_ARTIFACT_PATH=
CLOSETSEARCH_RECOMMENDATION_PROMOTION_APPROVED=false
CLOSETSEARCH_RECOMMENDATION_TIMEOUT_MS=25
CLOSETSEARCH_RECOMMENDATION_MAX_ARTIFACT_AGE_DAYS=45

# Provider runtime. Production must use real/false/false.
PROVIDER_RUNTIME_MODE=mock
PROVIDER_ALLOW_MOCK_FALLBACK=true
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_ACTIVE_PROVIDERS=5
PROVIDER_MOCK_ENABLED=true
LIVE_PROVIDER_SMOKE_TESTS=false

# eBay official API
EBAY_PROVIDER_ENABLED=false
EBAY_AUTHORIZATION_REFERENCE=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_IDENTITY_BASE_URL=https://api.ebay.com
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_LOCALE=en-US
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_AFFILIATE_CAMPAIGN_ID=
EBAY_AFFILIATE_REFERENCE_ID=
EBAY_REQUEST_TIMEOUT_MS=8000
EBAY_MIN_REQUEST_INTERVAL_MS=250
EBAY_MAX_CONCURRENCY=2
EBAY_MAX_RETRIES=2

# Grailed authorized acquisition. The operator has confirmed permission; an
# operator-supplied non-secret reference is still required to activate it.
GRAILED_PROVIDER_ENABLED=false
GRAILED_SCRAPING_ALLOWED=false
GRAILED_AUTHORIZATION_REFERENCE=
GRAILED_BASE_URL=https://www.grailed.com
GRAILED_REQUEST_TIMEOUT_MS=5000
GRAILED_MIN_REQUEST_INTERVAL_MS=3000
GRAILED_MAX_RESULTS_PER_SEARCH=24
GRAILED_MAX_CONCURRENCY=2
GRAILED_MAX_RETRIES=2
GRAILED_BASE_BACKOFF_MS=250
GRAILED_MAX_RETRY_AFTER_MS=60000
GRAILED_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GRAILED_CIRCUIT_BREAKER_COOLDOWN_MS=30000
GRAILED_USER_AGENT=ClosetSearchBot/0.1 contact:<project-contact-email>

# Depop authorized acquisition
DEPOP_PROVIDER_ENABLED=false
DEPOP_SCRAPING_ALLOWED=false
DEPOP_AUTHORIZATION_REFERENCE=
DEPOP_BASE_URL=https://webapi.depop.com
DEPOP_REQUEST_TIMEOUT_MS=8000
DEPOP_MIN_REQUEST_INTERVAL_MS=2000
DEPOP_MAX_RESULTS_PER_SEARCH=48
DEPOP_MAX_CONCURRENCY=2
DEPOP_MAX_RETRIES=2
DEPOP_BASE_BACKOFF_MS=250
DEPOP_MAX_RETRY_AFTER_MS=60000
DEPOP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
DEPOP_CIRCUIT_BREAKER_COOLDOWN_MS=30000
DEPOP_USER_AGENT=ClosetSearchBot/1.0 contact:<project-contact-email>

# Yahoo! Auctions Japan authorized acquisition
YAHOO_AUCTIONS_JP_PROVIDER_ENABLED=false
YAHOO_AUCTIONS_JP_SCRAPING_ALLOWED=false
YAHOO_AUCTIONS_JP_AUTHORIZATION_REFERENCE=
YAHOO_AUCTIONS_JP_BASE_URL=https://auctions.yahoo.co.jp
YAHOO_AUCTIONS_JP_REQUEST_TIMEOUT_MS=8000
YAHOO_AUCTIONS_JP_MIN_REQUEST_INTERVAL_MS=2500
YAHOO_AUCTIONS_JP_MAX_RESULTS_PER_SEARCH=48
YAHOO_AUCTIONS_JP_MAX_CONCURRENCY=2
YAHOO_AUCTIONS_JP_MAX_RETRIES=2
YAHOO_AUCTIONS_JP_BASE_BACKOFF_MS=250
YAHOO_AUCTIONS_JP_MAX_RETRY_AFTER_MS=60000
YAHOO_AUCTIONS_JP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
YAHOO_AUCTIONS_JP_CIRCUIT_BREAKER_COOLDOWN_MS=30000
YAHOO_AUCTIONS_JP_USER_AGENT=ClosetSearchBot/1.0 contact:<project-contact-email>

# Mercari Japan authorized acquisition (intentionally separate from Mercari US)
MERCARI_JP_PROVIDER_ENABLED=false
MERCARI_JP_SCRAPING_ALLOWED=false
MERCARI_JP_AUTHORIZATION_REFERENCE=
MERCARI_JP_BASE_URL=https://api.mercari.jp
MERCARI_JP_REQUEST_TIMEOUT_MS=8000
MERCARI_JP_MIN_REQUEST_INTERVAL_MS=2500
MERCARI_JP_MAX_RESULTS_PER_SEARCH=48
MERCARI_JP_MAX_CONCURRENCY=2
MERCARI_JP_MAX_RETRIES=2
MERCARI_JP_BASE_BACKOFF_MS=250
MERCARI_JP_MAX_RETRY_AFTER_MS=60000
MERCARI_JP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
MERCARI_JP_CIRCUIT_BREAKER_COOLDOWN_MS=30000
MERCARI_JP_USER_AGENT=ClosetSearchBot/1.0 contact:<project-contact-email>

# Worker
WORKER_CONCURRENCY=4
WORKER_PROVIDER_INGESTION_ENABLED=true
WORKER_DEFAULT_INGESTION_QUERY=designer clothing
WORKER_ACTIVE_INGESTION_INTERVAL_SECONDS=900
WORKER_SOLD_INGESTION_INTERVAL_SECONDS=3600
WORKER_INGESTION_PAGE_SIZE=50
WORKER_INGESTION_SEARCHES_JSON=
WORKER_LEASE_DURATION_MS=60000
WORKER_POLL_INTERVAL_MS=2000
WORKER_ID=

# Web build-time configuration
VITE_API_BASE_URL=http://localhost:4000

# Smoke tests
CLOSETSEARCH_API_BASE_URL=http://127.0.0.1:4000
CLOSETSEARCH_SMOKE_TIMEOUT_MS=5000
CLOSETSEARCH_SMOKE_REQUIRE_HTTPS=false
CLOSETSEARCH_EXPECTED_PROVIDER_IDS=
CLOSETSEARCH_OPERATIONS_BEARER_TOKEN=
