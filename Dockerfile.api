# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=24.5.0

FROM node:${NODE_VERSION}-bookworm-slim AS build
ENV COREPACK_HOME=/corepack
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

COPY . .
RUN corepack pnpm install --frozen-lockfile \
  && corepack pnpm --filter @closetsearch/api... build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /workspace/apps/api

LABEL org.opencontainers.image.source="https://github.com/BricenPeinado/closetsearch" \
      org.opencontainers.image.title="ClosetSearch API"

RUN mkdir -p /var/lib/closetsearch \
  && chown -R node:node /var/lib/closetsearch

COPY --from=build --chown=node:node /workspace/node_modules /workspace/node_modules
COPY --from=build --chown=node:node /workspace/apps/api/node_modules /workspace/apps/api/node_modules
COPY --from=build --chown=node:node /workspace/apps/api/package.json /workspace/apps/api/package.json
COPY --from=build --chown=node:node /workspace/apps/api/dist /workspace/apps/api/dist
COPY --from=build --chown=node:node /workspace/packages/providers/package.json /workspace/packages/providers/package.json
COPY --from=build --chown=node:node /workspace/packages/providers/node_modules /workspace/packages/providers/node_modules
COPY --from=build --chown=node:node /workspace/packages/providers/dist /workspace/packages/providers/dist
COPY --from=build --chown=node:node /workspace/packages/shared/package.json /workspace/packages/shared/package.json
COPY --from=build --chown=node:node /workspace/packages/shared/dist /workspace/packages/shared/dist

USER node
EXPOSE 4000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4000/health/live',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "dist/server.js"]
