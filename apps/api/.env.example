# ClosetSearch API beta example environment

HOST=127.0.0.1
PORT=4000
CLOSETSEARCH_DB_PATH=./.data/closetsearch.sqlite

AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_COOKIE_NAME=closetsearch_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_SESSION_PEPPER=

PROVIDER_RUNTIME_MODE=mock
PROVIDER_ALLOW_MOCK_FALLBACK=true
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_ACTIVE_PROVIDERS=2
PROVIDER_MOCK_ENABLED=true

GRAILED_PROVIDER_ENABLED=false
GRAILED_SCRAPING_ALLOWED=false
GRAILED_BASE_URL=https://www.grailed.com
GRAILED_REQUEST_TIMEOUT_MS=5000
GRAILED_MIN_REQUEST_INTERVAL_MS=3000
GRAILED_MAX_RESULTS_PER_SEARCH=24
GRAILED_USER_AGENT=ClosetSearchBot/0.1 contact:<project-contact-email>
