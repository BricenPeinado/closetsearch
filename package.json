{
  "name": "closetsearch",
  "version": "0.0.0",
  "private": true,
  "description": "AI-friendly monorepo skeleton for a clothing resale search app.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "corepack pnpm -r --parallel --if-present dev",
    "dev:web": "corepack pnpm --filter @closetsearch/web dev",
    "dev:api": "corepack pnpm --filter @closetsearch/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "test:integration": "corepack pnpm --filter @closetsearch/api test:integration",
    "test:e2e": "playwright test",
    "db:migrate": "corepack pnpm --filter @closetsearch/api db:migrate",
    "db:seed": "corepack pnpm --filter @closetsearch/api db:seed",
    "beta:smoke": "node scripts/beta-smoke-test.mjs",
    "smoke:production": "node scripts/production-smoke-test.mjs",
    "smoke:test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.0"
  }
}
