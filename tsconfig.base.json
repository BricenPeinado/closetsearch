{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@closetsearch/shared": ["packages/shared/src/index.ts"],
      "@closetsearch/providers": ["packages/providers/src/index.ts"]
    }
  }
}
